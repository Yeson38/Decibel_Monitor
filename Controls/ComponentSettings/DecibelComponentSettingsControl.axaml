<ci:ComponentBase
    x:Class="Decibel_Monitor.Controls.ComponentSettings.DecibelComponentSettingsControl"
    x:TypeArguments="componentSettingsModel:DecibelComponentSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:local="clr-namespace:Decibel_Monitor.Controls.ComponentSettings"
    xmlns:componentSettingsModel="clr-namespace:Decibel_Monitor.Models.ComponentSettings"
    mc:Ignorable="d">

    <!-- 本面板（"小组件显示侧"）仅包含该组件的显示偏好。
         测量/校准（参考 dB、放大倍数）为全局设置，请到 设置 → Decibel_Monitor 页 校准；
         提醒判定（何时提醒）在 设置 → Decibel_Monitor 页 → 提醒判定，
         提醒正文与语音在 设置 → 通知 → 分贝提醒。 -->
    <ScrollViewer
        DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:DecibelComponentSettingsControl}}}">
        <StackPanel Classes="settings-container animated-intro" Margin="12" Spacing="8">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock VerticalAlignment="Center" Width="88" Text="提醒状态点" />
                <ToggleSwitch IsChecked="{Binding Settings.ShowStatusIndicator, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock VerticalAlignment="Center" Width="88" Text="分贝: 前缀" />
                <ToggleSwitch IsChecked="{Binding Settings.ShowDecibelPrefix, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock VerticalAlignment="Center" Width="88" Text="更新频率" />
                <Slider Width="200" Minimum="100" Maximum="1000" TickFrequency="50"
                        Value="{Binding Settings.UpdateIntervalMs, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" />
                <TextBlock VerticalAlignment="Center" Width="110"
                           Text="{Binding Settings.UpdateIntervalMs, StringFormat='{}{0} ms'}" />
            </StackPanel>

            <TextBlock FontSize="12" Classes="muted"
                       Text="显示设置：开启“分贝: 前缀”时数值显示为“分贝: 70.0”形式；“更新频率”越小数值响应越快（建议 100–500 ms）。"
                       TextWrapping="Wrap"/>

            <TextBlock FontSize="12" Classes="muted"
                       Text="开启“提醒状态点”后，组件数值右侧会显示一个形状：绿圆表示正常，红空心方表示提醒已发出、正处于冷却期（冷却期内即使仍超阈值也保持空心方，表示“提醒已发生过”），红实心方表示正在超阈值（只在判定源冷却时间为 0 时可见）；显示橙色三角时表示“热键确认”的筛选窗口已开启、正在等待按键，窗口即将超时时三角会呼吸。无采样或未启用任何判定源时不显示形状。关闭“提醒状态点”后仍会正常发出系统通知，只是不在组件上显示状态点。"
                       TextWrapping="Wrap"/>

            <TextBlock FontSize="12" Classes="muted"
                       Text="分贝数值由全局校准决定（同一麦克风所有组件显示一致）。校准与放大倍数请到 设置 → Decibel_Monitor 页 操作。"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>


